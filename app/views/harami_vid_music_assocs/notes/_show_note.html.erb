<%# locals: (from_non_turbo: nil) %>

<%# Assumed instance variables: @hvma %>

<%= turbo_frame_tag dom_id(@hvma, :note) do %>
  <span class="note text-start">
    <% title_txt = +"Note for this association" %>
    <% title_txt << "; HaramiVidMusicAssc(ID=#{@hvma.id})" if can?(:edit, HaramiVid) %>
    <span class="hvma-note" title="<%= title_txt %>"><%= ModuleRedcarpetAux.md2safehtml(@hvma.note) %></span>
  </span>
  <% if can? :edit, @hvma.harami_vid %>
    <%= link_to "Edit", edit_harami_vid_music_assocs_note_path(@hvma), class: "edit_link text-end inline_form_tightest button_like" %><%# NOTE: "inline_form_tight" for button_to may be implemented... %>
  <% end %>

 <% if !from_non_turbo  %>
  <%= render partial: "/layouts/flash_display" %>
 <% end %>
<% end %>

