<%# locals: (record: , is_to_edit: , only: :editor, below_destroy: nil, with_index_link: nil, destroy_text: nil, confirm_message: nil) %>

<% raise ArgumentError, "Specify the correct ActiveRecord instance for 'record'!" if !record %>
<% klass_merge = record.class.name.pluralize.constantize::MergesController %>
<% can_merge = (can?(:update, record) && can?(:update, klass_merge)) %>
<% msg2confirm = t('are_you_sure') + " " + t("are_you_sure_but_merge") %>
<%= render(layout: 'layouts/link_edit_destroy_index',
           locals: {record: record,  is_to_edit: is_to_edit, only: only, can_merge: can_merge, confirm_message: msg2confirm}) do %>
  <% model_name = record.class.name %>
  <% model_underscore = model_name.underscore %>
  <% path_new = send(model_underscore.pluralize + "_new_merges_path", record) %>
  <% link_txt = "Merge with another #{model_name}" %>
  <%= button_to link_txt, path_new, method: :get, title: "You will be asked to select #{model_name} to merge this one with." %><%# "=" at the left-bracket is important! %>
<% end %>

