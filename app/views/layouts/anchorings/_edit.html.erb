<%# locals: (anchoring: @anchoring) %>

<main class="container">
  <div class="header">
    <h1>Edit Anchoring (for <%= anchoring.anchorable.class.name %>-Url)</h1>
  </div>

  <%= turbo_frame_tag dom_id(anchoring) do %>  <%# "anchoring_123" %>
    <%= render partial: "/layouts/anchorings/form", locals: {anchoring: anchoring} %> 
    <%# NOTE: +render 'form'+ would refer to _form.html.erb in the caller's directory like views/musics/anchorings/_form.html.erb %>
  <% end %>
</main>

