<%# locals: (record: , is_to_edit: , only: :editor, below_destroy: nil, with_index_link: nil, destory_text: nil, with_destroy: false, destroyable: nil, can_merge: false) %>
<%# Description: is_to_edit (mandatory) should be true if it is for "edit" screen, else (if it is "Show" screen) false.  %>
<%#   below_destroy: HTML inserted below the destroy link/button inside the editor_only block. %>
<%#   destory_text: Text for Destroy Button (if nil (Def), it depends on is_to_edit - "Destroy" in Show) %>
<%#   with_index_link: Link for Index is inserted if true; in default (nil), true if !is_to_edit (namely if in Show page). %>
<%#   with_destroy: if true (Def: false), destroyable has a priority over record.destroyable? %>
<%#   destroyable: Read only when with_destroy is truthy.  Specify true if the record is destroyable by the user with the model-constraint also considered(!). This basically overwrites the result of record.destroyable? %>

<% destory_text = (is_to_edit ? "Destroy this "+record.class.name : "Destroy") if destory_text.blank? %>
<% with_index_link = !is_to_edit if with_index_link.nil? %>

<% model_name = record.class.name %>
<% model_underscore = model_name.underscore %>
<% can_update = (!record.new_record? && can?(:update, record)) %>
<% can_destroy = (can_update && can?(:destroy, record)) %>

<%= editor_only_safe_html(:pass, method: can_update, only: !is_to_edit && only, tag: "div", class: "link-edit-destroy") do %>  <%# If in :edit (or :new), "editor_only" css-class is not added, but in :show %> <%# defined in application_helper.rb %>

  <% css_is_edit_or_show = (is_to_edit ? "in_edit" : "in_show") %>
  <%= tag.section(id: Consts::HtmlIds::MAIN_LINK_EDIT_MERGE_DESTROY, class: css_is_edit_or_show) do %>
    <%= tag.div class: "actions" do %>
      <% if !is_to_edit %> <%# If in "Edit", this part is not displayed. %>
        <% path_edit = polymorphic_path(record, action: :edit, only_path: true) %> <%# e.g., edit_music_path(record) %>
        <%= tag.span class: "lead" do %>
          <%= link_to "Edit this #{record.class.name}", path_edit, class: "edit_link link-edit", data: { turbo_frame: "_top" } %><%# link-edit CSS class for backward-compatibility %>
        <% end %>
      <% end %>

      <% if (can_destroy || can_merge) %>
        <% manual_destroyable = (with_destroy && destroyable) %>
        <% do_respond = record.respond_to?(:destroyable?) %>
        <% if manual_destroyable || do_respond %>
          <%= tag.div class: ["actions-destroy", "actions-destroy-align-r"] do %>
            <% if manual_destroyable || record.destroyable? %>
              <%= destroy_link(record, destory_text, extra_classes: ["destroy_link"]) %><%# defined in application_helper.rb %>
            <% else %><%# i.e., if !record.destroyable? && (!with_destroy || !destroyable)  %>
              <form class="button_to"><input disabled="disabled" type="submit" value="Destroy"></form>
              <% klass = model_name.constantize %>
              <% msg_detail = (klass.const_defined?(:DEPENDENT_CHILDREN) ? " "+klass.const_get(:DEPENDENT_CHILDREN).inspect  : "") %>
              (<%= model_name %> has dependent children<%= msg_detail %> or is "unknown?", and so cannot be destroyed.)
            <% end %>
          <% end %> <!--  div class="actions-destroy actions-destroy-align-r" -->
        <% elsif can_merge %>
          <% raise "#{record.class.name} does not have .destroyable? method unexpectedly despite the fact can_merge is true, which is NOT supported here. Contact the code developer." %>
        <% else %>
          &nbsp;&nbsp; / <%= destroy_link(record, is_button: false, extra_classes: ["destroy_link"]) %>
          (<%= tag.span "EDITOR: destroyable? is not defined, so destroying may fail.", class: "text-red" %>)
        <% end %>
      <% end %>
    <% end %> <!--  div class="actions"-->

    <% if below_destroy %>
      <br>
      <%= below_destroy.html_safe? ? below_destroy : sanitize(below_destroy) %>
    <% end %>
  <% end %><!-- section id="main_link_edit_merge_destroy" -->
<% end %> <%# editor_only_safe_html(:pass, ...) %>

<% show_link = nil %>
<% if is_to_edit %>
  <% show_link = link_to('Show', record) %>
<% end %>

<% if with_index_link %>
  <%= tag.p class: "navigate-link-below-form" do %>
    <%= show_link %>
    <%= editor_only_safe_html(record.class, method: :index, tag: "span") do %> <%# defined in application_helper.rb %>
      <%= show_link ? " | " : "<br>".html_safe %>
      <%= link_to(t("layouts.back_to_index"), send(model_underscore.pluralize+"_path")) %>
    <% end %>
  <% end %>
<% end %>

