<%# locals: (anchoring: @anchoring, anchorable: @anchorable) %>

<h1>New Anchoring (for Url)</h1>

<%# new_turbo_tag = dom_id(Anchoring.new) %>  <%# "new_anchoring" %>
<%= turbo_frame_tag  dom_id(anchoring) do %><%# Note: Here, (dom_id(anchoring) == dom_id(Anchoring.new) == "new_anchoring") %>
 <% if true %>
  <% if params[:cancel] %>
    <%= link_to 'New Anchoring', new_polymorphic_path([anchorable, anchoring]), class: "new_link" %>
  <% else %>
    <%# render "form", anchoring: @anchoring, anchorable: @anchorable %>
    <%= render partial: "/layouts/form_anchoring", locals: {anchoring: anchoring, anchorable: anchorable} %> 
  <% end %>
 <% else %>
  <%= render partial: "/layouts/form_anchoring", locals: {anchoring: anchoring, anchorable: anchorable} %> 
 <% end %>
<% end %>

