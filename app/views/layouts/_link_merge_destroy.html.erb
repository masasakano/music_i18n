<%# locals: (record:,  is_to_edit: ) %>
<%# is_to_edit: true if this is included in :edit page %>

<% model_name = record.class.name %>
<% model_underscore = model_name.underscore %>
<% can_update = (!record.new_record? && can?(:update, record)) %>
<% can_update_in_show = (can_update && !is_to_edit) %>
<% if can_update_in_show %>
  <div class="link-edit-destroy editor_only">  <%# "editor_only" css-class added only in Show (not in Edit) %>
    <% path_edit = send("edit_"+model_underscore+"_path", record) %> <%# e.g., edit_music_path(record) %>
    <span class="lead"><%= link_to 'Edit', path_edit, class: "link-edit" %></span> <%# -------- show only %>
<% end %>
<% klass_merge = model_name.pluralize.constantize::MergesController %>
<% if !record.new_record? && (can?(:destroy, record) || can?(:update, record) && can?(:update, klass_merge)) %>
  <% if can_update %>
  <div class="actions-destroy actions-destroy-align-r">
   <div class="actions">
  <% end %>
     <% if can?(:update, record) && can?(:update, klass_merge) %>
       <% path_new = send(model_underscore.pluralize + "_new_merges_path", record) %>
       <% link_txt = "Merge with another #{model_name}" %>
       <% if !record.new_record? %>
       <%= button_to         link_txt, path_new, method: :get, title: "You will be asked to select #{model_name} to merge this one with." %>
       <% else %>
  &nbsp;&nbsp; / <%= link_to link_txt, path_new %>
       <% end %>
     <% end %>

     <% if can?(:destroy, record) && !record.harami_vids.exists? && !record.harami1129s.exists?  && !record.harami1129s.exists? && (!record.respond_to?(:channel_owner) || !record.channel_owner) %>
      <% msg2confirm = (t('are_you_sure')+" "+t("are_you_sure_but_merge")).html_safe %>
      <% if !record.new_record? %>
       <%= destroy_link(record, extra_classes: ["destroy_link"], confirm_message: t("layouts.OMG_whats_this")) %><%# defined in application_helper.rb %>
      <% else %>
  &nbsp;&nbsp; / <%= destroy_link(record, is_button: false) %>
      <% end %>
     <% else %>
      <% if !record.new_record? %> <%# ----- In "show", nothing related to "Destroy" is shown. %> <%# I think this is redundant and unnecessary, because when it is a new record, this point should not be reached in the first place. %>
       <form class="button_to"><input disabled="disabled" type="submit" value="Destroy"></form>
       (<%= model_name %> has dependent HaramiVids and/or Harami1129s <%= "and/or ChannelOwner" if record.respond_to?(:channel_owner) %> and so cannot be destroyed.)
      <% end %>
     <% end %>
  <% if can_update %>
   </div>
  </div>
  <% end %>
<% end %>
<% if can_update_in_show %>
  </div>
<% end %>

<% linkhtml = link_to t("layouts.back_to_index"), send(model_underscore.pluralize+"_path") %>
<% if is_to_edit %>
  <% if "Artist" == model_name && record.new_record? && can_update %>
  <p class="artist-caution-in-add-music-below-form">
  (<%= t("artists.new.please_add_music", default: "Please add a Music(s) once you have created an Artist." ) %>)
  </p>
 <% end %>
  <p class="navigate-link-below-form">
    <%= link_to 'Show', record %> |
    <%= linkhtml %>
<% else %>
  <p class="navigate-link-below-form">
    <%= linkhtml %>
<% end %>
  </p>

