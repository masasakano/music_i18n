<%# locals: (record:,  is_to_edit: , only: :editor) %>
<%# is_to_edit: true if this is included in :edit page %>

<% model_name = record.class.name %>
<% model_underscore = model_name.underscore %>
<% klass_merge = model_name.pluralize.constantize::MergesController %>

<% can_update = can?(:update, record) %>
<% can_destroy = (can_update && can?(:destroy, record)) %>
<% can_merge   = (can_update && can?(:update, klass_merge)) %>

<% if !record.new_record? %>
<%= editor_only_safe_html(:pass, method: can_update, only: !is_to_edit && only, tag: "div", class: "link-edit-destroy") do %>  <%# If in :edit (or :new), "editor_only" css-class is not added, but in :show %> <%# defined in application_helper.rb %>
  <% css_is_edit_or_show = (is_to_edit ? "in_edit" : "in_show") %>
    <%= tag.div class: "actions" do %>
      <% if !is_to_edit %> <%# If in "Edit", neither this part not "section" is displayed. %>
    <% path_edit = send("edit_"+model_underscore+"_path", record) %> <%# e.g., edit_music_path(record) %>
        <%= tag.span class: "lead" do %>
          <%= link_to 'Edit', path_edit, class: "link-edit" %> <%# -------- show only %>
        <% end %>
      <% end %>
      <% if (can_destroy || can_merge) %>
          <%= tag.div class: ["actions-destroy", "actions-destroy-align-r"] do %>
     <% if can_merge %>
       <% path_new = send(model_underscore.pluralize + "_new_merges_path", record) %>
       <% link_txt = "Merge with another #{model_name}" %>
       <%= button_to         link_txt, path_new, method: :get, title: "You will be asked to select #{model_name} to merge this one with." %>
     <% end %>

     <% if can_destroy && !record.harami_vids.exists? && !record.harami1129s.exists?  && !record.harami1129s.exists? && (!record.respond_to?(:channel_owner) || !record.channel_owner) %>
      <% msg2confirm = (t('are_you_sure')+" "+t("are_you_sure_but_merge")).html_safe %>
       <%= destroy_link(record, extra_classes: ["destroy_link"], confirm_message: msg2confirm) %><%# defined in application_helper.rb %>
     <% else %>
       <%# ----- In "show", nothing related to "Destroy" is shown. %> <%# I think this is redundant and unnecessary, because when it is a new record, this point should not be reached in the first place. %>
       <form class="button_to"><input disabled="disabled" type="submit" value="Destroy"></form>
       (<%= model_name %> has dependent HaramiVids and/or Harami1129s <%= "and/or ChannelOwner" if record.respond_to?(:channel_owner) %> and so cannot be destroyed.)
     <% end %>
          <% end %> <!--  div class="actions-destroy actions-destroy-align-r" -->
      <% end %> <%# if (can_destroy || can_merge) %>
    <% end %> <!--  div class="actions"-->
<% end %> <%# editor_only_safe_html(:pass, ...) %>
<% end %><%# if !record.new_record? %>

<% linkhtml = link_to t("layouts.back_to_index"), send(model_underscore.pluralize+"_path") %>
<p class="navigate-link-below-form">
  <% if is_to_edit %>
    <%= link_to 'Show', record %> |
  <% end %>
  <%= linkhtml %>
</p>

