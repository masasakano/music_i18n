<%# locals: (form: , record: , form_method: nil, selected: nil, with_place_select: true) %>
<%# Description:
     record: Place record (maybe new_record). For Place :new, record.prefecture would be nil.
     form_method: method of +record+ to get Place if with_place_select is true, or else Prefecture. Default is :place_id or :prefecture_id .
     selected: Already selected Place-pID if any.
     with_place_select: renders also a Place select if true (Def). Basically, false only for Place :new/:edit
%>
<%# NOTE: The HTML-IDs for select tags are country_id, prefecture_id, place_id
      as opposed to "music_place_id" for +name+ attribute of "music[place_id]" etc.
%>

<%# NOTE: maybe Default Country, and Prefecture/Place may be unknown %>
<% raise "selected must be pID or nil but looks like ActiveRecord: "+selected.inspect if selected.presence && selected.respond_to?(:id) %>
<% form_method ||= (with_place_select ? :place_id : :prefecture_id) %>
<% if with_place_select %>
  <% selected_place_id = (selected.presence || record.send(form_method).presence) %>
  <% selected_place = selected_place_id.presence && Place.find(selected_place_id) %> <%# maybe nil %>
<% else %>
  <% selected_prefecture_id = (selected.presence || record.send(form_method).presence) %>
  <% selected_prefecture = selected_prefecture_id.presence && Prefecture.find(selected_prefecture_id) %> <%# maybe nil %>
  <% selected_place = record %>
<% end %>

<% selected_country = selected_place&.country || selected_prefecture&.country || Country.unknown %>
<% selected_country_id = selected_country.id %>
<% selected_prefecture ||= selected_place&.prefecture || selected_country.unknown_prefecture %>

<% if with_place_select %>
  <% selected_place_id ||= selected_prefecture.unknown_place.id %><%# Usually Integer but possibly String if the given +selected+ is String %>
<% end %>

<%= stimulus_controller_block(
      "cascadingSelectAny",
      values: {},
      style: "margin-bottom: -1.5em; padding-bottom: 0em;") do %> <%# defined in stimulus_helper.rb %>
<%# div data-controller="cascading-select-any"
     style="margin-bottom: -1.5em; padding-bottom: 0em;" %>

 <div class="cascade_select mb-3">
  <!-- Country Filter -->
  <div id="div_select_country">
    <%= label_tag :country_id, t(:Country).capitalize, class: "form-label" %>
    <%= select_tag :country_id,
          options_from_collection_for_select((@countries || Country.sorted_for_display), :id, :title_or_alt_for_selection, selected_country_id),
          data: {
            cascading_select_any_target_param: "prefectures_select_frame",
            cascading_select_any_url_param: country_prefectures_path(country_id: ":id"),
            action: "change->cascading-select-any#update"
          } %><%# defined in countries_helper.rb %>
            <%# Set this to clear Place-select completely after changing Country: cascading_select_any_clear_param: "places_select_frame", %>
    <%= form.error :country_id, class: "text-danger small" %>
  </div>

  <%# Target Prefecture Select %>
  <% hsdata = {
        cascading_select_any_target_param: (with_place_select ? "places_select_frame" : nil),
        cascading_select_any_url_param: prefecture_places_path(prefecture_id: ":id"),
        action: "change->cascading-select-any#update"
     } %>
  <%= tag.div id: "div_select_prefecture", data: hsdata do %>
    <%= label_tag :prefecture_id, t(:Prefecture).capitalize, class: "form-label" %>

    <turbo-frame id="prefectures_select_frame"> <%# matches /app/views/countries/prefectures/index.html.erb %>
      <%= render "countries/prefectures/select",
            records: selected_country&.prefectures || @prefectures || [],
            selected: selected_prefecture&.id
       %><%# NOTE: data-* are defined in /app/views/countries/prefectures/_select.html.erb %>
    </turbo-frame>
    <%= form.error :prefecture_id, class: "text-danger small" %>
  <% end %>

  <%# Target Place Select %>
 <% if with_place_select %>
  <%= tag.div id: "div_select_place" do %>
    <%= form.label :place_id, t(:Place).capitalize, for: :place_id, class: "form-label" %><%# Option "for" is mandatory, or you may use label_tag instead. %>
    <turbo-frame id="places_select_frame"> <%# matches /app/views/prefectures/places/index.html.erb %>
      <%= render "prefectures/places/select",
            records: selected_prefecture&.places|| @places || [],
            selected: selected_place_id
       %>
    </turbo-frame>
    <%= form.error form_method.to_sym, class: "text-danger small" %>
  <% end %>
 <% end %><%# if with_place_select %>
 </div> <!-- div class="cascade_select" -->
<% end %> <%# stimulus_controller_block(...) %>
