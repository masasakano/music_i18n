<%# locals: () %>
<turbo-frame id="events_select_frame"> <%# matches /app/views/layouts/_form_select_event.html.erb %>
  <% field_name = params[:select_name].presence || "event_id" %>
  <% selected   = params[:selected].presence %>
  <% is_required = ActiveModel::Type::Boolean.new.cast(params[:required]) %>
  <%= render "event_groups/events/select",
        events: @events,
        field_name: field_name,
        selected: selected,
        required: is_required %>
</turbo-frame>

