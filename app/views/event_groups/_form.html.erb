
<%= render partial: 'layouts/form_print_errors', locals: {model: event_group} %>

<% if ! event_group.new_record? %>
<hr>
<%= render partial: 'layouts/all_registered_translations', locals: {model: event_group, add_buttons: true} %>
<hr>
<% end %>
<%= tag.section id: "sec_primary" do %>
<% if ! event_group.new_record? %>

<h2>Unique parameters</h2>
<% end %>

  <%= tag.div id: "form_main" do %>
<%= simple_form_for event_group do |f| %>
 <section id="sec_primary_input">
  <% if event_group.new_record? %>
    <%= render partial: 'layouts/partial_new_translations', locals: {form: f, is_simple_form: true, use_form_attributes: true} %>
  <% end %>

  <%= render partial: "layouts/form_select_place", locals: {form: f, record: event_group} %>

  <% start_y, end_y = evgr_start_date_select_range_start_end_year(event_group) %> <%# defined in event_groups_helper.rb %>
  <%= f.input :start_date, start_year: start_y, end_year: end_y %>
  <%= f.input :start_date_err, label: "± days (Start)" %>

  <% start_y, end_y = evgr_end_date_select_range_start_end_year(event_group) %> <%# defined in event_groups_helper.rb %>
  <%= f.input :end_date, start_year: start_y, end_year: end_y %>
  <%= f.input :end_date_err, label: "± days (End)" %>

  <%= render partial: 'layouts/form_note_memo_editor', locals: {form: f, model4ability: event_group, skip_ability_check: true} %>

  <%= f.submit %>
  <div class="actions">
  <%= submit_tag(t("layouts.reset_button"), { :name => 'reset', :id => 'reset_button', :type => "reset" }) %>
  </div>
 </section> <!-- section id="sec_primary_input" -->
<% end %>

  <% end %> <!-- div id="form_main" -->
<% end %> <!-- tag.section id: "sec_primary" do -->

