<h1>ModelSummary: <%= @model_summary.modelname %></h1>

<hr>
<%= render partial: 'layouts/all_registered_translations', locals: {model: @model_summary} %>
<%= render partial: 'model_summary', locals: {model_summary: @model_summary} %>

<hr>

<div>
  <%= link_to "Edit this ModelSummary", edit_model_summary_path(@model_summary) %> |
  <%= link_to "Back to Index", model_summaries_path %>

  <% if can?(:destroy, @model_summary) %>
    <%= destroy_link @model_summary, inline: true, is_button: true, extra_classes: [Consts::Csses::Layouts::DESTROY_LINK] %> <%# defined in application_helper.rb %>
  <% end %>
</div>
