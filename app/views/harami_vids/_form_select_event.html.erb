<%# locals: (f: , harami_vid: @harami_vid, selected: "", is_required: false) %>
<%# is_required is true only for :new because an existing HaramiVid should have at least one associated Event %>

<% current_year = Time.current.year %>
<% year_options = (Rails.configuration.music_i18n_def_first_event_year..current_year).to_a.reverse %>

<% evt_id = (harami_vid.form_new_event_id.presence || selected.presence) %>
<% current_event = (evt_id ? Event.find(evt_id) : nil) %>
<% if current_event %>
  <% selected_group_id = (current_event&.event_group_id || EventGroup.default(:HaramiVid)) %>
  <% selected_year_begin = current_event&.start_time&.year || current_year %>
<% end %>
<% selected_year_end = nil %>

<% group_options = [["(All Event Groups)", "all"]] + form_all_event_group_collection %> <%# EventGroup.pluck(:title, :id) %>

<div data-controller="cascading-select" 
     data-cascading-select-url-template-value="/event_groups/:event_group_id/events"
     data-cascading-select-select-name-value="harami_vid[form_new_event_id]"
     data-cascading-select-selected-value="<%= selected %>"
     data-cascading-select-required-value="<%= is_required %>"
     style="margin-bottom: -1.5em; padding-bottom: 0em;" >

  <!-- Event Group Filter -->
  <div class="mb-3">
    <%= label_tag :event_group_id, "Event Group", class: "form-label" %>
    <%= select_tag :event_group_id,
          options_for_select(group_options, selected_group_id),
          include_blank: "Select Event Group...",
          class: "form-select",
          data: {
            cascading_select_target: "input",
            param_name: "event_group_id",
            action: "change->cascading-select#update"
          } %>
  </div>

  <!-- Year Range Filters: -->
  <div class="row" style="margin-top: -1.5em;">
    <!-- Year Range Filter: from -->
    <div class="col-md-6 mb-3">
      <%= label_tag :year_begin, "Year From (nb. #{Rails.configuration.music_i18n_def_first_event_year} includes before)", class: "form-label" %>
      <%= select_tag :year_begin,
            options_for_select(year_options, selected_year_begin),
            class: "form-select",
            data: {
              cascading_select_target: "input",
              param_name: "year_begin",
              action: "change->cascading-select#update"
            } %>
    </div>

    <!-- Year Range Filter: to -->
    <div class="col-md-6 mb-3">
      <%= label_tag :year_end, "Year To (Def: Same year as Start)", class: "form-label" %>
      <%= select_tag :year_end,
            options_for_select(year_options, selected_year_end),
            include_blank: "Not specified",
            class: "form-select",
            data: {
              cascading_select_target: "input",
              param_name: "year_end",
              action: "change->cascading-select#update"
            } %>
    </div>
  </div>

  <%# Target Event Select %>
  <div class="mb-3" style="margin-top: -1.5em; margin-bottom: 0em; padding-bottom: 0em;">
    <%= f.label :form_new_event_id, (is_required ? "Event" : "Additional Event (for EventItem)"), class: "form-label" %>

    <turbo-frame id="events_select_frame" data-cascading-select-target="frame">
      <% initial_events =
           if selected_group_id
             events = EventGroups::EventsController.filter_events(selected_group_id, selected_year_begin, selected_year_end) if selected_year_begin.present?  # MAIN routine!
           else
             []
           end %>

      <%= f.input_field :form_new_event_id,
            collection: initial_events,
            required: is_required,
            label_method: :title_or_alt_for_selection,
            value_method: :id,
            selected: (current_event ? current_event.id : nil),
            include_blank: initial_events.any? ? "Select an Event..." : "Select an Event Group first...",
            class: "form-select" %>
    </turbo-frame>
    <%= f.error :form_new_event_id, class: "text-danger small" %>
  </div>

</div>

