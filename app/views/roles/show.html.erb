<p>
  <strong>pID:</strong>
  <%= @role.id %>
</p>

<p>
  <strong>Name (unique within RoleCategory):</strong>
  <%= @role.name %>
</p>

<p>
  <strong>uname (unique in all Roles):</strong>
  <%= @role.uname %>
</p>

<p>
  <strong>Role category:</strong>
  <%= sprintf '%d (%s)', @role.role_category_id, @role.role_category.mname %>
</p>

<p>
  <strong>Weight:</strong>
  <%= @role.weight %>
</p>

<p>
  <strong>Note:</strong>
  <%= auto_link(@role.note) %>
</p>

<%= editor_only_safe_html(@role, method: :edit, tag: "span", only: :admin) do %>
  <%= link_to 'Edit', edit_role_path(@role) %> |
<% end %>
<%= link_to 'Index', roles_path %>

<hr>

<table>
  <thead>
    <tr><th>pID</th><th>Display_name</th><th>Email</th><th>Last sign-in</th><th>Created at</th></tr>
  </thead>
  <tbody>
    <% @role.users.order("users.created_at").each do |user| %>
      <tr>
        <td><%= user.id %></td>
        <td><%= link_to user.display_name, user %></td>
        <td><%= user.email.sub(/@.+/, "@...") %></td>
        <td><%= user.last_sign_in_at %></td>
        <td><%= user.created_at %></td>
      </tr>
    <% end %>
  </tbody>
</table>

