<p id="notice"><%= notice %></p>

<%= tag.h1 "Roles", class: "admin_only" %>

<table>
  <thead>
    <tr>
      <th>Name<br> (unique within RoleCategory)</th>
      <th>uname<br> (unique in all Roles)</th>
      <th>Role category</th>
      <th>Weight</th>
      <th title="Number of Users of this Role">#Users</th>
      <th>Note</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @roles.each do |role| %>
      <tr>
        <td><%= role.name %></td>
        <td><%= role.uname || '&mdash;'.html_safe() %></td>
        <td><%= sprintf '%d (%s)', role.role_category_id, role.role_category.mname %></td>
        <td><%= role.weight %></td>
        <td><%= role.users.count %></td>
        <td><%= auto_link50(role.note) %></td>
        <td><%= link_to 'Show', role %></td>
        <td><%= tag.span link_to('Edit', edit_role_path(role)), class: "admin_only" %></td>
        <td>&nbsp;&nbsp;&nbsp;
          <% if role.destroyable? %>
            <%= link_to 'Destroy', role, method: :delete, data: { confirm: t('are_you_sure') } %>
          <% else %>
            <%= tag.span "Destroy", class: "cell_disable_link", title: "NOT destroyable because Users exist" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= editor_only_safe_html(Role, method: :create, tag: "div", only: :admin) do %>
<%= link_to 'New Role', new_role_path %>
<% end %>
