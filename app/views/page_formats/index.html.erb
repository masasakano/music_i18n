<h1>Page Formats</h1>

<table>
  <thead>
    <tr>
      <th>Mname</th>
      <th>Description</th>
      <th>Note</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @page_formats.each do |page_format| %>
      <tr>
        <td><%= page_format.mname %></td>
        <td><%= page_format.description %></td>
        <td><%= auto_link50(page_format.note) %></td>
        <%= render "layouts/show_edit_destroy_in_table", record: page_format, canedit_gen: true, candestroy_gen: true, destroyable: page_format.static_pages.blank? %>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Page Format', new_page_format_path %>
