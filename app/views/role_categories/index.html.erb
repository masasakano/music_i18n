<%= editor_only_safe_html(:pass, method: true, only: :admin, tag: "h1", text: "Role Categories") %>

<% canedit_gen    = can?(:edit,    RoleCategory) %>
<% candestroy_gen = can?(:destroy, RoleCategory) %>
<table>
  <thead>
    <tr>
      <th>Mname</th>
      <th>#Roles</th>
      <th>Note</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @role_categories.each do |role_category| %>
      <tr>
        <td><%= role_category.mname %></td>
        <td><%= role_category.roles.size %></td>
        <td><%= auto_link50(role_category.note) %></td>
        <%= render "layouts/show_edit_destroy_in_table", record: role_category, canedit_gen: canedit_gen, candestroy_gen: candestroy_gen, only: :moderator, destroyable: role_category.roles.blank? %>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= editor_only_safe_html(:pass, method: true, only: :admin) do %>
<%= link_to 'New Role Category', new_role_category_path %>
<% end %>
