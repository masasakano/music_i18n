
<h1>Instruments</h1>

<% canedit_gen    = can?(:edit,    Instrument) %>
<% candestroy_gen = can?(:destroy, Instrument) %>
<div id="instruments">
<table id="instruments_index_table" class="table_index">
  <thead>
    <tr>
      <th>ID</th>
       <%= render "layouts/title_alt_ja_en_table", model: nil, langcodes: %w(ja en) %>  <%# class="title_alt_ja" etc %>
      <th>Weight</th>
      <th title="Note in this DB">Note</th>
      <% if canedit_gen %>
        <th colspan="<%= 1 + [canedit_gen, candestroy_gen].count(true) %>"></th>
      <% else %>
        <th></th>
      <% end %>
    </tr>
  </thead>

  <tbody>
    <% @instruments.each do |model| %>
      <tr>
        <td><%= model.id %></td>
       <%= render "layouts/title_alt_ja_en_table", model: model, langcodes: %w(ja en) %>  <%# class="title_alt_ja" etc %>

        <td><%= model.weight %></td>
        <td><%= auto_link50(h(model.note)) %></td>

        <%= render "layouts/show_edit_destroy_in_table", record: model, canedit_gen: canedit_gen, candestroy_gen: candestroy_gen %>
      </tr>
    <% end %>
  </tbody>
</table>
</div>

<br>

<% if can? :create, Instrument %>
  <%= button_to 'New Instrument', new_instrument_path, method: :get %>
<% end %>

